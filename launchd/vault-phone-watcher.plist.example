<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.vault-phone-watcher</string>
    <!-- Interpreter is the system python3 ON PURPOSE. The watcher is stdlib-only.
         Do NOT repoint this at .venv/bin/python: that symlink is unsafe in
         iCloud-synced folders and the venv is irrelevant to this script. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/ABS/PATH/TO/CHECKOUT/bin/vault-phone-watcher</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/ABS/PATH/TO/iCloud/VaultDrop</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/ABS/PATH/TO/CHECKOUT/vault-personal/_maintenance/phone-watcher.err.log</string>
</dict>
</plist>
