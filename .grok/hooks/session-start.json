{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$GROK_WORKSPACE_ROOT/bin/vault-session-start-stamp",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_WORKSPACE_ROOT}/bin/vault-prompt-match\" --hook --root \"${GROK_WORKSPACE_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
