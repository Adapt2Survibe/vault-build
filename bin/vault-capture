#!/usr/bin/env python3
"""vault-capture — rapid capture into a vault inbox.

Zero-dependency (stdlib only): capture must work instantly from any shell.
Contract: vault-librarian/CONTRACTS.md § bin/vault-capture.

Usage:
    vault-capture <text words...>        quick text note
    vault-capture <existing-file-path>   stage a file copy
    vault-capture <http(s)://url>        stage a URL for fetch-on-ingest
    vault-capture -                      read note body from stdin

Options:
    --vault personal|company   target vault (default: personal)
    --title TEXT               note title (also drives the filename slug)
    --tags a,b,c               comma-separated tags
    --via LABEL                provenance label in front matter (default: vault-capture)

On success prints exactly one line to stdout: the absolute path of the
created inbox file. Errors go to stderr with exit code 1.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path
from urllib.parse import urlparse

DEFAULT_ROOT = str(Path(__file__).resolve().parents[1])
SLUG_MAX_CHARS = 40
SLUG_WORDS = 6
URL_RE = re.compile(r"^https?://", re.IGNORECASE)


def fail(message: str) -> int:
    print(f"vault-capture: error: {message}", file=sys.stderr)
    return 1


def slugify(source: str) -> str:
    """Lowercase, [a-z0-9-] only, max 40 chars, no leading/trailing hyphen."""
    slug = re.sub(r"[^a-z0-9]+", "-", source.lower()).strip("-")
    slug = slug[:SLUG_MAX_CHARS].rstrip("-")
    return slug or "capture"


def create_unique(inbox: Path, stem: str, suffix: str, data: bytes) -> Path:
    """Exclusively create <stem><suffix> (collision: -2, -3, ...) and write data.

    open(..., 'x') makes the check-and-create atomic: two same-second captures
    with the same slug must never silently overwrite each other.
    """
    counter = 1
    while True:
        name = f"{stem}{suffix}" if counter == 1 else f"{stem}-{counter}{suffix}"
        dest = inbox / name
        try:
            with open(dest, "xb") as fh:
                fh.write(data)
            return dest
        except FileExistsError:
            counter += 1


def looks_pathlike(arg: str) -> bool:
    """Heuristic: the user almost certainly meant a file path, not a note.

    Whitespace disqualifies — real paths don't contain spaces, while quoted
    prose notes routinely contain slashes and tildes.
    """
    if any(c.isspace() for c in arg):
        return False
    return "/" in arg or arg.startswith(("~", "./", "../"))


def yaml_scalar(value: str) -> str:
    """Quote a string safely for YAML (JSON string scalars are valid YAML)."""
    return json.dumps(value, ensure_ascii=False)


def front_matter(
    captured: str,
    type_hint: str,
    title: str | None,
    tags: list[str],
    url: str | None,
    via: str = "vault-capture",
) -> str:
    lines = [
        "---",
        f"captured: {captured}",
        f"via: {yaml_scalar(via)}",
        f"type_hint: {type_hint}",
    ]
    if title:
        lines.append(f"title: {yaml_scalar(title)}")
    if tags:
        lines.append("tags: [" + ", ".join(yaml_scalar(t) for t in tags) + "]")
    if url:
        lines.append(f"url: {yaml_scalar(url)}")
    lines.append("---")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="vault-capture", description="Rapid capture into the vault inbox."
    )
    parser.add_argument("input", nargs="*", help="text words, a file path, a URL, or - for stdin")
    parser.add_argument("--vault", choices=("personal", "company"), default="personal")
    parser.add_argument("--title", default=None)
    parser.add_argument("--tags", default=None, help="comma-separated tags")
    parser.add_argument(
        "--via", default=None, help="provenance label recorded in front matter"
    )
    args = parser.parse_args(argv)
    # Default applied AFTER parsing so "was --via passed?" stays answerable below;
    # comparing against the string would misread an explicit --via vault-capture.
    via = args.via if args.via is not None else "vault-capture"

    root = Path(os.environ.get("VAULT_ROOT", DEFAULT_ROOT)).expanduser()
    inbox = root / f"vault-{args.vault}" / "inbox"
    if not inbox.is_dir():
        return fail(f"inbox directory missing: {inbox}")

    if not args.input:
        return fail("nothing to capture")

    now = datetime.now()
    ts = now.strftime("%Y-%m-%d-%H%M%S")
    captured = now.isoformat(timespec="seconds")
    title: str | None = args.title
    tags = [t.strip() for t in args.tags.split(",") if t.strip()] if args.tags else []

    single = args.input[0] if len(args.input) == 1 else None

    # File capture: copy verbatim, no front matter, original untouched.
    if single is not None and single != "-" and not URL_RE.match(single):
        src = Path(single).expanduser()
        if src.is_file():
            # Verbatim is the contract, so the metadata flags have nowhere to go --
            # but discarding them in silence lets stated provenance vanish on exit 0.
            # Say so on stderr; stdout stays exactly one line and the bytes are untouched.
            ignored = [
                flag
                for flag, passed in (
                    ("--title", args.title is not None),
                    ("--tags", args.tags is not None),
                    ("--via", args.via is not None),
                )
                if passed
            ]
            if ignored:
                print(
                    f"vault-capture: warning: {', '.join(ignored)} ignored for a file capture "
                    "(files are copied verbatim with no front matter; Scribe derives metadata "
                    "at ingest). Put provenance in the file itself if it must survive.",
                    file=sys.stderr,
                )
            dest = create_unique(inbox, f"{ts}-{src.stem}", src.suffix, src.read_bytes())
            shutil.copystat(src, dest)
            print(dest.resolve())
            return 0
        if looks_pathlike(single):
            # A typo'd path silently becoming a text note (whose body is the
            # path string) looks like success — fail loudly instead.
            return fail(f"file not found: {single} (quote the text if you meant a note)")

    if single == "-":
        text = sys.stdin.read().strip()
        type_hint, url = "note", None
    elif single is not None and URL_RE.match(single):
        text = single
        type_hint, url = "website", single
    else:
        text = " ".join(args.input).strip()
        type_hint, url = "note", None

    if not text:
        return fail("nothing to capture")

    if title:
        slug_source = title
    elif url:
        parsed = urlparse(url)
        slug_source = f"{parsed.netloc}{parsed.path}"
    else:
        slug_source = " ".join(text.split()[:SLUG_WORDS])

    body = "(URL capture — fetch on ingest)" if url else text
    fm = front_matter(captured, type_hint, title, tags, url, via=via)
    content = fm + "\n\n" + body + "\n"
    dest = create_unique(inbox, f"{ts}-{slugify(slug_source)}", ".md", content.encode("utf-8"))
    print(dest.resolve())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as exc:
        sys.exit(fail(str(exc)))
