#!/usr/bin/env python3
"""SessionStart stamp — Grok ignores hook stdout, so health goes to a file.

Writes vault-personal/_maintenance/session-start-stamp.json (gitignored with
the data tree). Does not inject into the model. Title inject is the committed
file .grok/rules/vault-lesson-index.md.
"""
from __future__ import annotations

import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
STAMP = REPO / "vault-personal" / "_maintenance" / "session-start-stamp.json"
DOCTOR = REPO / "bin" / "vault-doctor"


def main() -> int:
    ran_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = ""
    ok = False
    try:
        proc = subprocess.run(
            [sys.executable, str(DOCTOR), "--session-start"],
            capture_output=True,
            text=True,
            timeout=12,
        )
        line = (proc.stdout or proc.stderr or "").strip().splitlines()
        line = line[0] if line else f"exit {proc.returncode}"
        ok = proc.returncode == 0 and line.startswith("vault: ok")
    except (OSError, subprocess.TimeoutExpired) as exc:
        line = f"doctor failed: {exc}"

    STAMP.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "ran_at": ran_at,
        "ok": ok,
        "detail": line,
        "cadence": "every Grok SessionStart in this checkout",
    }
    STAMP.write_text(json.dumps(payload) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
